# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# JPEG Compression Quality (1-100)
# Lower = smaller file size, faster streaming, lower quality
# Higher = better quality, larger file size, slower streaming
JPEG_QUALITY=80

# Camera Stream Settings
# Frame buffer size (lower = less latency, may drop frames)
BUFFER_SIZE=1

# Default FPS for cameras that don't report FPS
DEFAULT_FPS=30
